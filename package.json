{
  "name": "apollo-client-mock-directive-plugin",
  "version": "0.1.0",
  "description": "Apollo Client link implementing the GraphQL @mock directive specification",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@apollo/client": ">=3.0.0",
    "graphql": ">=15.0.0"
  },
  "devDependencies": {
    "@apollo/client": "^4.1.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "graphql": "^16.13.0",
    "jsdom": "^28.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.4.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "graphql",
    "apollo",
    "mock",
    "directive",
    "apollo-client",
    "apollo-link"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/magicmark/apollo-client-mock-directive-plugin.git"
  }
}
